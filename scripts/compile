#!/bin/sh
# compile - Compile a single source file with cosmocc/cosmoc++
# Usage: compile <source.c> [flags...]
#
# Outputs object file to $BUILD_DIR/<source>.o (default: .build)

set -e

SRC="$1"
shift
FLAGS="$@"

if [ -z "$SRC" ]; then
    echo "Usage: compile <source.c> [flags...]"
    exit 1
fi

# Allow configurable build directory (default: .build)
BUILD_DIR="${BUILD_DIR:-.build}"

# Determine output path
BASENAME=$(basename "$SRC")
DIRNAME=$(dirname "$SRC")
OBJ="${BUILD_DIR}/${DIRNAME}/${BASENAME%.c*}.o"

# Create output directory
mkdir -p "$(dirname "$OBJ")"

# Choose compiler based on extension
case "$SRC" in
    *.cpp|*.cc|*.cxx)
        CC=cosmoc++
        ;;
    *)
        CC=cosmocc
        ;;
esac

# Compile
$CC -c $FLAGS -o "$OBJ" "$SRC"
